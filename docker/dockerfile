# Dockerfile
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt --use-deprecated=legacy-resolver

COPY app/ app/
COPY main.py .
COPY static/ static/
COPY VERSION .

EXPOSE 8000

CMD ["uvicorn", "main:app", "--workers", "2", "--host", "0.0.0.0", "--port", "8000"]